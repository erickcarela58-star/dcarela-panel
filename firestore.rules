rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership() {
      return get(/databases/$(database)/documents/business_members/$(request.auth.uid)).data;
    }
    function isActiveMember(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/business_members/$(request.auth.uid))
        && membership().active == true
        && businessId in membership().business_ids;
    }
    function isAdmin(businessId) {
      return isActiveMember(businessId) && membership().role in ['owner', 'admin'];
    }
    function canSell(businessId) {
      return isActiveMember(businessId) && membership().role in ['owner', 'admin', 'cajero'];
    }
    function keepsBusiness() {
      return request.resource.data.business_id == resource.data.business_id;
    }

    match /business_members/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }
    match /businesses/{businessId} {
      allow read: if isActiveMember(businessId);
      allow update: if isAdmin(businessId);
      allow create, delete: if false;
    }

    match /sync_events/{eventId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string
        && canSell(request.resource.data.business_id)
        && request.resource.data.event_id == eventId
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'business_id', 'device_id', 'event_id', 'event_type', 'entity_type',
          'entity_id', 'payload', 'created_at_local', 'received_at_cloud',
          'status', 'source', 'created_by_uid'
        ]);
      allow update, delete: if false;
    }
    match /cash_shifts/{shiftId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string
        && canSell(request.resource.data.business_id)
        && request.resource.data.opened_by_uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if keepsBusiness() && canSell(resource.data.business_id)
        && resource.data.opened_by_uid == request.auth.uid
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
    match /sales/{saleId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string
        && canSell(request.resource.data.business_id)
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.status == 'closed';
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id)
        && request.resource.data.status in ['closed', 'cancelled'];
      allow delete: if false;
    }
    match /counters/{counterId} {
      allow read: if resource.data.business_id is string && canSell(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && canSell(request.resource.data.business_id);
      allow update: if keepsBusiness() && canSell(resource.data.business_id);
      allow delete: if false;
    }

    match /products/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }
    match /categories/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }
    match /clients/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }
    match /fin_accounts/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }
    match /fin_movements/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string
        && isAdmin(request.resource.data.business_id)
        && request.resource.data.created_by_uid == request.auth.uid;
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }
    match /fin_categories/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }

    match /system_alerts/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string && isAdmin(request.resource.data.business_id);
      allow update: if keepsBusiness() && isActiveMember(resource.data.business_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'acknowledged_at', 'acknowledged_by', 'updated_at'
        ]);
      allow delete: if false;
    }

    match /ui_preferences/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if request.resource.data.business_id is string
        && isActiveMember(request.resource.data.business_id)
        && request.resource.data.user_id == request.auth.uid;
      allow update: if keepsBusiness() && isActiveMember(resource.data.business_id)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    match /fin_preferences/{businessId} {
      allow read: if isActiveMember(businessId);
      allow create, update: if isAdmin(businessId)
        && request.resource.data.business_id == businessId;
      allow delete: if false;
    }

    // Historial privado del cerebro local. Cada usuario solo puede leer y
    // conservar sus propias conversaciones; las operaciones comerciales se
    // siguen ejecutando contra las colecciones tipadas y sus reglas separadas.
    match /assistant_users/{userId}/conversations/{conversationId} {
      allow read: if signedIn()
        && userId == request.auth.uid
        && resource.data.business_id is string
        && isActiveMember(resource.data.business_id)
        && resource.data.created_by_uid == request.auth.uid;
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.business_id is string
        && isActiveMember(request.resource.data.business_id)
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.engine == 'local-firebase';
      allow update: if signedIn()
        && userId == request.auth.uid
        && keepsBusiness()
        && isActiveMember(resource.data.business_id)
        && resource.data.created_by_uid == request.auth.uid
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.engine == 'local-firebase';
      allow delete: if false;
    }

    // --- SaleAds: modulos operativos compartidos por sucursal -----------
    // Activos, experimentos, atribucion y auditoria son append-only: se crean
    // con el uid del actor y no se actualizan ni se borran nunca. La capacidad
    // usa identificador determinista fecha+servicio, por lo que admite
    // correccion del mismo dia sin cambiar de sucursal ni de autor.
    function saleAdsCreate() {
      return request.resource.data.business_id is string
        && isAdmin(request.resource.data.business_id)
        && request.resource.data.created_by_uid == request.auth.uid;
    }

    match /saleads_assets/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if saleAdsCreate();
      allow update, delete: if false;
    }
    match /saleads_experiments/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if saleAdsCreate();
      allow update, delete: if false;
    }
    match /saleads_attribution/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if saleAdsCreate();
      allow update, delete: if false;
    }
    match /saleads_audit/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if saleAdsCreate();
      allow update, delete: if false;
    }
    match /saleads_capacity/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if saleAdsCreate();
      allow update: if keepsBusiness()
        && isAdmin(resource.data.business_id)
        && request.resource.data.created_by_uid == request.auth.uid;
      allow delete: if false;
    }

    match /{collectionId}/{documentId} {
      allow read: if resource.data.business_id is string && isActiveMember(resource.data.business_id);
      allow create: if collectionId in [
          'product_combos', 'expense_categories', 'expenses', 'cost_recurrents', 'cost_obligations',
          'cost_payments', 'payment_receipts', 'fin_cards', 'fin_budgets',
          'fin_currencies', 'fin_preferences', 'fin_commitments',
          'fin_commitment_payments', 'fin_pending_transfers', 'devices',
          'sales_archive', 'sync_event_archives', 'catalog_snapshots', 'suppliers',
          'crm_contacts', 'crm_conversations',
          'crm_messages', 'crm_templates', 'crm_campaigns', 'crm_tasks',
          'crm_plans', 'crm_prospects', 'crm_files', 'wa_bridge_control'
        ]
        && request.resource.data.business_id is string
        && isAdmin(request.resource.data.business_id);
      allow update: if collectionId in [
          'product_combos', 'expense_categories', 'expenses', 'cost_recurrents', 'cost_obligations',
          'cost_payments', 'payment_receipts', 'fin_cards', 'fin_budgets',
          'fin_currencies', 'fin_preferences', 'fin_commitments',
          'fin_commitment_payments', 'fin_pending_transfers', 'devices',
          'sales_archive', 'sync_event_archives', 'catalog_snapshots', 'suppliers',
          'crm_contacts', 'crm_conversations',
          'crm_messages', 'crm_templates', 'crm_campaigns', 'crm_tasks',
          'crm_plans', 'crm_prospects', 'crm_files', 'wa_bridge_control'
        ]
        && keepsBusiness() && isAdmin(resource.data.business_id);
      allow delete: if false;
    }

  }
}
